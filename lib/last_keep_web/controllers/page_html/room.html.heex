<div id="stage"></div>
<div id="turn" hidden>
  <div class="turn-card">
    <svg data-turn-icon viewBox="0 0 64 64" width="72" height="72" aria-hidden="true">
      <rect
        x="22"
        y="6"
        width="20"
        height="34"
        rx="3"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
      </rect>
      <path d="M44 30a16 16 0 1 1-5-12" fill="none" stroke="currentColor" stroke-width="2"></path>
      <path d="M39 12h8v8" fill="none" stroke="currentColor" stroke-width="2"></path>
    </svg>
    <p>Rotate your device</p>
  </div>
</div>
<div id="hud" hidden></div>
<form id="join-game" class="panel join-panel">
  <h1>Join the keep</h1>
  <label>
    Name <input id="player-name" name="name" maxlength="16" autocomplete="nickname" required />
  </label>
  <fieldset>
    <legend>Hero</legend>
    <div class="hero-picks">
      <label><input type="radio" name="hero" value="warrior" checked /> Warrior</label>
      <label><input type="radio" name="hero" value="mage" /> Mage</label>
      <label><input type="radio" name="hero" value="scout" /> Scout</label>
      <label><input type="radio" name="hero" value="farmer" /> Farmer</label>
      <label><input type="radio" name="hero" value="engineer" /> Engineer</label>
    </div>
  </fieldset>
  <button type="submit">Enter</button>
  <p id="join-error" class="error" hidden></p>
</form>
<div id="overlay" class="overlay" hidden></div>
